# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files (may contain environment-specific values)
*.tfvars
!terraform.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive local files
*.pem
*.key
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
